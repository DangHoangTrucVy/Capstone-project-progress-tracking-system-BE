@startuml SD01-login-password
!include _vp-style.iuml
mainframe **sd** SD01 Login with email and password (Admin, Moderator)

actor "Admin / Moderator" as U
boundary ":LoginScreen" as UI
control ":AuthController" as AC
control ":AuthService" as AS
participant ":LoginAttemptLimiter" as LIM
participant ":AuthenticationManager" as AM
entity ":UserRepository" as UR
participant ":JwtTokenProvider" as JWT

U -> UI : enterCredentials(email, password)
activate UI
UI -> AC : POST /api/v1/auth/login {email, password}
activate AC
AC -> AS : login(request)
activate AS
AS -> LIM : checkAllowed(email)
activate LIM
break too many failed attempts
  LIM --> UI : 429 TOO_MANY_LOGIN_ATTEMPTS
end
LIM --> AS : ok
deactivate LIM
AS -> UR : findByEmailIgnoreCase(email)
activate UR
UR --> AS : user
deactivate UR
break user.role = STUDENT
  AS --> UI : 403 GOOGLE_LOGIN_REQUIRED
end
AS -> AM : authenticate(email, password)
activate AM
alt wrong password / suspended / inactive
  AM --> AS : BadCredentials | Locked | Disabled
  AS -> LIM : recordFailure(email)
  AS --> UI : 401 INVALID_CREDENTIALS | 403 ACCOUNT_LOCKED
else valid
  AM --> AS : authenticated
  deactivate AM
  AS -> LIM : reset(email)
  AS -> JWT : generateAccessToken(id, email, role)
  activate JWT
  JWT --> AS : accessToken
  deactivate JWT
  AS --> AC : LoginResponse(accessToken, expiresIn, user)
  deactivate AS
  AC --> UI : 200 LoginResponse
  deactivate AC
  UI -> UI : saveToken(), openDashboard(role)
  UI --> U : dashboard (Admin or Moderator)
end
deactivate UI
@enduml
