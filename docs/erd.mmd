%% ERD - Website ghép nhóm (Team Formation Website), requirement v2.8
%% Generated from src/main/resources/db/migration V1-V18 (PostgreSQL). Every table except semesters and the
%% infrastructure tables also has created_at / updated_at, left out for readability. Actor columns (*_by) reference
%% USERS; only business relationships are drawn as lines, the others are marked "FK users".
%% Infrastructure tables with no relationships: email_outbox, domain_event_outbox.
erDiagram
    USERS |o--o{ SEMESTERS : "moderator_id"
    SEMESTERS ||--o{ SEMESTER_STUDENTS : "student list"
    USERS ||--o{ SEMESTER_STUDENTS : "user_id"
    MAJORS ||--o{ SEMESTER_STUDENTS : "major_id"
    SEMESTERS ||--o{ SUBJECTS : "semester_code"
    SUBJECTS ||--o{ FORMATION_SCOPES : "one per major"
    MAJORS ||--o{ FORMATION_SCOPES : "major_id"
    FORMATION_SCOPES ||--o{ ENROLLMENTS : "scope_id"
    SEMESTER_STUDENTS ||--o{ ENROLLMENTS : "one per subject"
    FORMATION_SCOPES ||--o{ STUDENT_GROUPS : "scope_id"
    STUDENT_GROUPS ||--o{ GROUP_MEMBERS : "group_id"
    ENROLLMENTS ||--o{ GROUP_MEMBERS : "at most 1 open"
    STUDENT_GROUPS ||--o{ JOIN_REQUESTS : "group_id"
    ENROLLMENTS ||--o{ JOIN_REQUESTS : "applicant / invitee"
    JOIN_REQUESTS ||--o{ APPLICATION_LIKES : "request_id"
    USERS ||--o{ APPLICATION_LIKES : "user_id"
    STUDENT_GROUPS ||--o{ LEAVE_REQUESTS : "group_id"
    ENROLLMENTS ||--o{ LEAVE_REQUESTS : "at most 1 open"
    STUDENT_GROUPS ||--o{ LEADER_TRANSFERS : "group_id"
    SEMESTERS |o--o{ IMPORT_BATCHES : "semester_code"
    USERS ||--o{ NOTIFICATIONS : "recipient_id"
    USERS |o--o{ SYSTEM_AUDIT_TRAIL : "performed_by"

    USERS {
        uuid id PK
        varchar email UK
        varchar full_name
        varchar password_hash
        varchar role "ADMIN|LECTURER|STUDENT"
        varchar status "ACTIVE|SUSPENDED|INACTIVE"
        varchar student_code UK
        varchar phone
        varchar skills
        varchar strengths
        varchar weaknesses
        boolean profile_private
        varchar avatar_url
    }
    SEMESTERS {
        varchar code PK "SP26|SU26|FA26"
        varchar name
        date start_date
        date end_date
        timestamp formation_opens_at "common opening date"
        timestamp default_deadline "common deadline"
        uuid moderator_id FK
        timestamp archived_at "status: computed + Archived"
    }
    MAJORS {
        uuid id PK
        varchar code UK
        varchar name UK
    }
    SEMESTER_STUDENTS {
        uuid id PK
        varchar semester_code FK "UK(semester_code, user_id)"
        uuid user_id FK
        uuid major_id FK
        int current_term "ky hoc hien tai"
    }
    SUBJECTS {
        uuid id PK
        varchar semester_code FK "UK(semester_code, code)"
        varchar code
        varchar name
        int target_term
        int min_group_size "3"
        int max_group_size "5"
        int request_ttl_hours "48"
        uuid created_by "FK users"
    }
    FORMATION_SCOPES {
        uuid id PK
        uuid subject_id FK "UK(subject_id, major_id)"
        uuid major_id FK
        varchar phase "PREPARING|OPEN|LOCKED|FINALIZED"
        timestamp deadline_override "null = common deadline"
        timestamp opened_at
        timestamp locked_at
        timestamp finalized_at
        uuid finalized_by "FK users"
        timestamp previous_finalized_at
        timestamp reopened_at
        uuid reopened_by "FK users"
        varchar reopen_reason
        varchar last_change_after_finalize
        timestamp last_change_after_finalize_at
        timestamp open_blocked_notified_at
    }
    ENROLLMENTS {
        uuid id PK
        uuid subject_id FK "UK(subject_id, user_id)"
        uuid scope_id FK
        uuid semester_student_id FK
        uuid user_id FK
        varchar eligibility "UNDECIDED|ELIGIBLE|INELIGIBLE"
        varchar eligibility_reason
        uuid eligibility_updated_by "FK users"
        timestamp eligibility_updated_at
        boolean finalized
        timestamp finalized_at
        varchar no_group_reason
    }
    STUDENT_GROUPS {
        uuid id PK
        uuid scope_id FK
        varchar code UK "FA26-CAP-SE-001"
        varchar name
        varchar wanted_skills
        boolean locked "Leader lock"
        uuid created_by "FK users"
        timestamp dissolved_at
        varchar dissolved_reason "TOO_SMALL_AT_DEADLINE|EMPTY|MODERATOR"
    }
    GROUP_MEMBERS {
        uuid id PK
        uuid group_id FK "UK(group_id) where leader and open"
        uuid enrollment_id FK "UK(enrollment_id) where open"
        uuid user_id FK
        boolean is_leader
        timestamp joined_at
        timestamp left_at
        varchar left_reason
    }
    JOIN_REQUESTS {
        uuid id PK
        uuid group_id FK "UK(group, enrollment, type) where PENDING"
        uuid enrollment_id FK
        uuid user_id FK
        varchar type "APPLY|INVITE"
        varchar status "PENDING|ACCEPTED|REJECTED|WITHDRAWN|EXPIRED|CANCELLED"
        varchar message
        varchar reject_reason
        varchar cancel_reason
        uuid created_by "FK users"
        timestamp expires_at
        timestamp responded_at
    }
    APPLICATION_LIKES {
        uuid id PK
        uuid request_id FK "UK(request_id, user_id)"
        uuid user_id FK
    }
    LEAVE_REQUESTS {
        uuid id PK
        uuid group_id FK
        uuid enrollment_id FK "UK(enrollment_id) where open"
        uuid user_id FK
        varchar status "PENDING_LEADER|PENDING_MODERATOR|APPROVED|REJECTED|WITHDRAWN|CLOSED"
        varchar reason
        boolean complaint
        uuid leader_decided_by "FK users"
        timestamp leader_decided_at
        varchar leader_note
        uuid decided_by "FK users"
        timestamp decided_at
        varchar decision_note
    }
    LEADER_TRANSFERS {
        uuid id PK
        uuid group_id FK "UK(group_id) where PENDING"
        uuid from_user_id "FK users"
        uuid to_user_id "FK users"
        boolean leave_after
        boolean after_finalize
        varchar status "PENDING|ACCEPTED|DECLINED|CANCELLED"
        timestamp responded_at
    }
    IMPORT_BATCHES {
        uuid id PK
        varchar kind "STUDENTS|ELIGIBILITY|LECTURERS"
        varchar semester_code FK
        varchar file_name
        uuid imported_by "FK users"
        timestamp imported_at
        int created_count
        int updated_count
        int error_count
        text errors_json
    }
    NOTIFICATIONS {
        uuid id PK
        uuid event_id "UK(event_id, recipient_id)"
        uuid recipient_id FK
        varchar type
        varchar message
        text details
        timestamp deadline
        uuid group_id
        uuid entity_id
        timestamp read_at
    }
    SYSTEM_AUDIT_TRAIL {
        uuid id PK
        varchar entity_name
        uuid entity_id
        varchar action
        uuid performed_by FK "null = system"
        varchar semester_code
        timestamp performed_at
        text details_json
    }
