@startuml
title <size:24>Dynamic View: Capstone Tracking System</size>\n<size:24>Auto-generating and signing off a meeting's minutes.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System_Boundary("CapstoneTrackingSystem_boundary", "Capstone Tracking System", $tags="") {
  ContainerDb(CapstoneTrackingSystem.Database, "Database", $techn="PostgreSQL 16", $descr="Stores all persistent application data; schema is fully owned by Flyway migrations (Hibernate ddl-auto=validate).", $tags="", $link="")
  Container(CapstoneTrackingSystem.WebApplication, "Web Application", $techn="SPA (framework TBD)", $descr="Single-page app used by all roles to browse slots, manage groups, and review meetings. Not part of this repository — inferred from the API's CORS allow-list (localhost:3000 / 5173).", $tags="", $link="")
  Container(CapstoneTrackingSystem.BackendAPI, "Backend API", $techn="Java 17 / Spring Boot 3.3.4", $descr="Serves the REST API for auth, scheduling, groups, artifacts, meetings, evaluation and reporting. Exposes an OpenAPI/Swagger UI for interactive docs.", $tags="", $link="")
}

Person(GroupLeader, "Group Leader", $descr="A student who leads their group: creates/joins the group, books assessment slots, submits artifacts, and signs meeting minutes.", $tags="", $link="")
Person(Instructor, "Instructor", $descr="A supervisor who publishes assessment slots, conducts meetings, records requirements, approves minutes, and evaluates groups.", $tags="", $link="")

Rel(GroupLeader, CapstoneTrackingSystem.WebApplication, "1: Enters meeting notes and requests a minutes draft", $techn="HTTPS", $tags="", $link="")
Rel(CapstoneTrackingSystem.WebApplication, CapstoneTrackingSystem.BackendAPI, "2: POST /api/v1/meetings/{id}/minutes/generate", $techn="JSON/HTTPS, JWT Bearer", $tags="", $link="")
Rel(CapstoneTrackingSystem.BackendAPI, CapstoneTrackingSystem.Database, "3: Reads raw notes + requirement logs, writes a Draft MeetingMinute (template-based, not AI-generated)", $techn="JDBC", $tags="", $link="")
Rel(GroupLeader, CapstoneTrackingSystem.WebApplication, "4: Reviews draft and submits", $techn="HTTPS", $tags="", $link="")
Rel(CapstoneTrackingSystem.WebApplication, CapstoneTrackingSystem.BackendAPI, "5: PUT /api/v1/meetings/{id}/minutes/sign (Leader submit)", $techn="JSON/HTTPS, JWT Bearer", $tags="", $link="")
Rel(Instructor, CapstoneTrackingSystem.WebApplication, "6: Reviews and approves/rejects", $techn="HTTPS", $tags="", $link="")
Rel(CapstoneTrackingSystem.WebApplication, CapstoneTrackingSystem.BackendAPI, "7: PUT /api/v1/meetings/{id}/minutes/sign (Instructor approve/reject)", $techn="JSON/HTTPS, JWT Bearer", $tags="", $link="")
Rel(CapstoneTrackingSystem.BackendAPI, CapstoneTrackingSystem.Database, "8: Updates MeetingMinute status to Approved/Rejected", $techn="JDBC", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml