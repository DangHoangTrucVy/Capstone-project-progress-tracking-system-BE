@startuml
title <size:24>Dynamic View: Capstone Tracking System</size>\n<size:24>A Group Leader books an assessment slot; the last seat cannot be double-booked.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System_Boundary("CapstoneTrackingSystem_boundary", "Capstone Tracking System", $tags="") {
  ContainerDb(CapstoneTrackingSystem.Database, "Database", $techn="PostgreSQL 16", $descr="Stores all persistent application data; schema is fully owned by Flyway migrations (Hibernate ddl-auto=validate).", $tags="", $link="")
  Container(CapstoneTrackingSystem.WebApplication, "Web Application", $techn="SPA (framework TBD)", $descr="Single-page app used by all roles to browse slots, manage groups, and review meetings. Not part of this repository — inferred from the API's CORS allow-list (localhost:3000 / 5173).", $tags="", $link="")
  Container(CapstoneTrackingSystem.BackendAPI, "Backend API", $techn="Java 17 / Spring Boot 3.3.4", $descr="Serves the REST API for auth, scheduling, groups, artifacts, meetings, evaluation and reporting. Exposes an OpenAPI/Swagger UI for interactive docs.", $tags="", $link="")
}

Person(GroupLeader, "Group Leader", $descr="A student who leads their group: creates/joins the group, books assessment slots, submits artifacts, and signs meeting minutes.", $tags="", $link="")

Rel(GroupLeader, CapstoneTrackingSystem.WebApplication, "1: Selects an available slot and confirms booking", $techn="HTTPS", $tags="", $link="")
Rel(CapstoneTrackingSystem.WebApplication, CapstoneTrackingSystem.BackendAPI, "2: POST /api/v1/slots/{id}/book (Bearer JWT)", $techn="JSON/HTTPS, JWT Bearer", $tags="", $link="")
Rel(CapstoneTrackingSystem.BackendAPI, CapstoneTrackingSystem.Database, "3: SELECT ... FOR UPDATE the slot row, then insert Confirmed booking + audit row (same transaction)", $techn="JDBC", $tags="", $link="")
Rel(CapstoneTrackingSystem.BackendAPI, CapstoneTrackingSystem.WebApplication, "4: 200 OK { bookingId, status: Confirmed } or 409 if the slot just filled", $techn="JSON/HTTPS, JWT Bearer", $tags="", $link="")
Rel(CapstoneTrackingSystem.WebApplication, GroupLeader, "5: Shows booking confirmation (or prompts to pick another slot)", $techn="HTTPS", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml