<mxfile host="app.diagrams.net" agent="capstone" version="24.0.0"><diagram id="ctx" name="L1 - System Context"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ctx-2" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;Student&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;Student without a group: creates a group (becomes Leader), applies to groups, accepts / declines invites; once in a group votes on applicants and requests to leave (decided by the Leader).&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctx-3" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Group Leader&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#cccccc&quot;&gt;Invites students by MSSV, approves / rejects applications, removes members, decides members' leave requests, locks and submits the roster (3-5 members); asks the Admin to leave the group.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="520" y="40" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctx-4" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;Admin&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;Approves personal-email sign-ups, imports the eligible student list, sets the formation deadline, adds / removes members, changes the Leader, decides Leader leave requests, approves rosters, exports the handover Excel.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="980" y="40" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctx-5" value='&lt;font style="font-size: 16px"&gt;&lt;b&gt;Team Formation System&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;Part of the Capstone Tracking System: eligibility list, Apply / Invite by MSSV with member votes, leave requests (Leader requests go to the Admin), roster lock &amp;amp; approval, in-app notifications, handover Excel export.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="420" y="340" width="400" height="200" as="geometry"/></mxCell><mxCell id="ctx-6" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;Google Identity&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[External System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;Google Sign-In (Google Identity Services). Only verified @fpt.edu.vn accounts are accepted.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="40" y="680" width="240" height="140" as="geometry"/></mxCell><mxCell id="ctx-7" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;Email Provider&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[External System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;SMTP server (e.g. Gmail). Sends sign-up approved / rejected emails. Off by default (MAIL_ENABLED=false: logged only).&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="960" y="680" width="240" height="140" as="geometry"/></mxCell><mxCell id="ctx-8" value='&lt;div style="text-align: center"&gt;&lt;b&gt;Joins or creates a group&lt;/b&gt;&lt;/div&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;' style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;jumpStyle=arcs;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-2" target="ctx-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-9" value='&lt;div style="text-align: center"&gt;&lt;b&gt;Recruits and finalizes the roster&lt;/b&gt;&lt;/div&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;' style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;jumpStyle=arcs;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-3" target="ctx-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-10" value='&lt;div style="text-align: center"&gt;&lt;b&gt;Imports eligibility, manages groups, exports Excel&lt;/b&gt;&lt;/div&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;' style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;jumpStyle=arcs;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-4" target="ctx-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-11" value='&lt;div style="text-align: center"&gt;&lt;b&gt;Signs in (all roles)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;[OpenID Connect]&lt;/div&gt;' style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;jumpStyle=arcs;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-2" target="ctx-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-12" value='&lt;div style="text-align: center"&gt;&lt;b&gt;Verifies Google ID tokens&lt;/b&gt;&lt;/div&gt;&lt;div&gt;[HTTPS, tokeninfo]&lt;/div&gt;' style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;jumpStyle=arcs;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-5" target="ctx-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-13" value='&lt;div style="text-align: center"&gt;&lt;b&gt;Sends sign-up result emails&lt;/b&gt;&lt;/div&gt;&lt;div&gt;[SMTP + STARTTLS]&lt;/div&gt;' style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;jumpStyle=arcs;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-5" target="ctx-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="ctn" name="L2 - Container"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ctn-2" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;Student&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;Student without a group: creates a group (becomes Leader), applies to groups, accepts / declines invites; once in a group votes on applicants and requests to leave (decided by the Leader).&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctn-3" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Group Leader&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#cccccc&quot;&gt;Invites students by MSSV, approves / rejects applications, removes members, decides members' leave requests, locks and submits the roster (3-5 members); asks the Admin to leave the group.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="790" y="40" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctn-4" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;Admin&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;Approves personal-email sign-ups, imports the eligible student list, sets the formation deadline, adds / removes members, changes the Leader, decides Leader leave requests, approves rosters, exports the handover Excel.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="1160" y="40" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctn-5" value='&lt;font style="font-size: 16px"&gt;&lt;b&gt;Team Formation System&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;' style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;connectable=0;absoluteArcSize=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="340" y="290" width="1100" height="900" as="geometry"/></mxCell><mxCell id="ctn-6" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;Web Application&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: React 19 SPA, Vite, Axios; Nginx 1.27]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;UI for the 3 roles. Nginx serves the built SPA and proxies /api/* to the API Application.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="750" y="330" width="280" height="150" as="geometry"/></mxCell><mxCell id="ctn-7" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;API Application&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Java 17, Spring Boot 3.3.4]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;REST API: formation rules (3-5 members, deadline, eligibility), Spring Security (JWT, RBAC by role, ownership checks), Flyway, notification &amp;amp; email outbox, SSE, Excel import/export (Apache POI).&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="750" y="590" width="280" height="190" as="geometry"/></mxCell><mxCell id="ctn-8" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;Database&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: PostgreSQL 16]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;Users &amp;amp; eligibility, groups, members, applications / invites &amp;amp; votes, leave requests, notifications, event &amp;amp; email outbox.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="750" y="900" width="280" height="170" as="geometry"/></mxCell><mxCell id="ctn-9" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;Message Queue&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Amazon SQS, optional]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;Carries domain events when MESSAGING_TYPE=sqs; default is in-process.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="400" y="840" width="260" height="130" as="geometry"/></mxCell><mxCell id="ctn-10" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;Cache&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Redis 7, optional]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;Response cache and login attempt limiter when REDIS_ENABLED=true.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="400" y="1020" width="260" height="130" as="geometry"/></mxCell><mxCell id="ctn-11" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;Google Identity&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[External System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;Google Sign-In (Google Identity Services). Only verified @fpt.edu.vn accounts are accepted.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="40" y="500" width="240" height="140" as="geometry"/></mxCell><mxCell id="ctn-12" value='&lt;font style="font-size: 14px"&gt;&lt;b&gt;Email Provider&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[External System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;SMTP server (e.g. Gmail). Sends sign-up approved / rejected emails. Off by default (MAIL_ENABLED=false: logged only).&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex