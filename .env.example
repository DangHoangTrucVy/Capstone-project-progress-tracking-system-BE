# Copy to .env (or set as IntelliJ Run Configuration environment variables) and fill in real values.
# Never commit the real .env file.

DB_URL=jdbc:postgresql://localhost:5432/capstone_tracking
DB_USERNAME=capstone_user
DB_PASSWORD=capstone_pass

# 32+ bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-dev-only-secret-key-please-override-in-prod-min-32-bytes
JWT_ACCESS_EXP_MIN=60
JWT_REFRESH_EXP_DAYS=7

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_EMAIL_DOMAIN=fpt.edu.vn

# Google Workspace sign-in: OAuth client id(s) of the FE's "Sign in with Google" button (comma-separated)
GOOGLE_CLIENT_IDS=
# Explicit fallback for provisioned accounts in local development; Google-only by default.
PASSWORD_LOGIN_ENABLED=false

# Email notifications (off = logged only). Gmail: MAIL_USERNAME=<account>, MAIL_PASSWORD=<app password>
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=capstone-tracking@fpt.edu.vn
# How often the email outbox is dispatched / retried (ms)
MAIL_DISPATCH_DELAY_MS=5000

# Max final defenses running at the same time (rolling schedule)
DEFENSE_MAX_PARALLEL=5

# GitHub Project connection (used by BA-Blueprint-Agent/skills/github-project-sync)
GITHUB_PROJECT_URL=https://github.com/OWNER/REPOSITORY/projects/NUMBER
GITHUB_OWNER=OWNER
GITHUB_REPOSITORY=REPOSITORY
GITHUB_PROJECT_NUMBER=NUMBER
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=

# Keep true until the mapping has been reviewed.
GITHUB_PROJECT_DRY_RUN=true
GITHUB_DEFAULT_BRANCH=main
