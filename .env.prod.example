# Copy to .env.prod and fill in. Never commit .env.prod.
# Do NOT use the "$" character in any value (Docker Compose treats it as a variable).

POSTGRES_DB=capstone_tracking
POSTGRES_USER=capstone_user
# 48 hex chars, e.g. from PowerShell (see deployment guide)
POSTGRES_PASSWORD=

# At least 32 characters
JWT_SECRET=

# FE origins: with https://, no trailing slash, comma-separated
CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000,http://localhost:5173

ALLOWED_EMAIL_DOMAIN=fpt.edu.vn,gmail.com

# dev = load sample data (db/seed) for FE testing; prod = empty database. Pick once, do not switch later.
SPRING_PROFILES_ACTIVE=dev

# Only the part after "--token" from the Cloudflare tunnel install command
CLOUDFLARE_TUNNEL_TOKEN=

# Loopback port for testing on this PC (8080 is used by the dev docker-compose.yml)
APP_LOCAL_PORT=8081
